# =============================================================================
# 后端环境变量示例 —— 不含任何真实密钥，可直接复制使用
#   copy backend\.env.example backend\.env
# Preview / Production 请在 Vercel Project Settings → Environment Variables 配置，
# 三个环境必须使用各自独立的数据库与密钥（见 docs/deployment-vercel.md 第 3 节）。
# 注意: 任何密钥都不得使用 VITE_ 前缀，也不得提交到仓库。
# =============================================================================

# -------------------------------- 基础 --------------------------------
# development | preview | production
APP_ENV=development
APP_NAME=edu-ai-assistant-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -------------------------------- 安全 --------------------------------
# 必填（开发环境同样必填）：访问令牌的签名密钥，长度不少于 32 字符。
# 生成方式:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# 契约固定值，一般无需修改（Access 1 小时 / Refresh 7 天）
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ----------------------------- 登录失败限流 ----------------------------
# 同一规范化邮箱在窗口内的失败次数达到上限后，短时间内拒绝登录（429）
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_FAILURES=5

# -------------------------------- CORS --------------------------------
# 逗号分隔的明确来源；禁止使用通配符 *（本服务需要携带凭据）
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可选：Preview 部署的域名白名单正则，例如
#   ^https://edu-ai-frontend-[a-z0-9-]+\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# ------------------------------- 数据库 -------------------------------
# PostgreSQL 连接串；postgres:// 与 postgresql:// 都会自动规范化为
# postgresql+asyncpg://，query 中的 sslmode 会转换为显式 TLS。
# 示例: postgresql://user:password@localhost:5432/edu_ai
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
# /health/ready 探测超时上限，需明显小于平台探针超时
DB_READY_TIMEOUT_SECONDS=3
DB_ECHO=false

# --------------------- 对象存储（浏览器直传，后端只签发）----------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --------------------------------- AI ---------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# ------------------------------ 异步任务 -------------------------------
JOB_CALLBACK_SECRET=
