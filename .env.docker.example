# Copy to .env on the server. Keep this file private and out of Git.
POSTGRES_DB=edu_ai
POSTGRES_USER=edu_ai
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=https://your-domain.example
HTTP_PORT=80

# Upload limits in bytes. Keep all three aligned with the frontend's 1 MiB limit.
MATERIAL_MAX_UPLOAD_BYTES=1048576
SUBMISSION_MAX_UPLOAD_BYTES=1048576
ASSIGNMENT_ATTACHMENT_MAX_UPLOAD_BYTES=1048576

# Store uploaded files in the Docker persistent volume mounted at /data/uploads.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
# Keep empty for same-origin upload/download URLs through the frontend proxy.
STORAGE_PUBLIC_BASE_URL=

# Optional AI provider settings
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
EMBEDDING_MODEL=
