# Copy to .env on the server. Keep this file private and out of Git.
POSTGRES_DB=edu_ai
POSTGRES_USER=edu_ai
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=https://your-domain.example
HTTP_PORT=80

# Configure the S3-compatible storage endpoint, bucket and credentials.
# Browser direct uploads require this endpoint to be publicly reachable over HTTPS.
STORAGE_ENDPOINT=https://your-public-s3-endpoint.example
STORAGE_BUCKET=edu-ai
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true

# Optional AI provider settings
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
EMBEDDING_MODEL=
