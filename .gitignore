# ----------------------------- 虚拟环境 -----------------------------
.venv/
venv/
env/

# ----------------------------- Python 缓存 --------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ----------------------------- 测试 / 覆盖率 -------------------------
.pytest_cache/
# 超时机制自测用的内层用例目录（隐藏目录，pytest 不收集；由测试运行时生成）
backend/tests/.inner_tmp/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# 测试超时事件与线程栈快照（本地产物，见 backend/tests/conftest.py）
test-reports/

# ----------------------------- 环境变量 -----------------------------
.env
.env.local
.env.*.local
!.env.example

# ----------------------------- 工具本地数据 -------------------------
# 本机助手的工作目录（含 memory 与缓存），不进版本库
.learnbuddy/
# 本机 CodeBuddy 工作目录（项目级数据与缓存），不进版本库
.codebuddy/

# ----------------------------- IDE --------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
